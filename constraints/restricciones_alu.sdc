set_input_delay -clock clk  -max 2  [get_ports {alu_control_in[1]}]
set_input_delay -clock clk  -max 2  [get_ports {alu_control_in[0]}]
set_output_delay -clock clk  -max 2  [get_ports {result_out[15]}]
